# Google Calendar integration (see docs/05-feature-calendar.md)
# All three must be set for live calendar data. Without them, mock data is used.
GOOGLE_CALENDAR_API_KEY=
GCAL_SPORTS_ID=
GCAL_COMMUNITY_ID=

